 UnpinnedTabContainerView::~UnpinnedTabContainerView() = default;
 
+bool UnpinnedTabContainerView::ShowsAtlasSectionHeaders() const {
+  return collection_node_ &&
+         collection_node_->orientation() == TabStripOrientation::kVertical &&
+         GetTabStripCollapseState() ==
+             tabs::VerticalTabStripCollapseState::kExpanded;
+}
+
+std::vector<std::optional<atlas::sidebar::Section>>
+UnpinnedTabContainerView::GetAtlasSectionHeaders(
+    const std::vector<const views::View*>& shown) const {
+  std::vector<atlas::sidebar::SectionRow> rows;
+  rows.reserve(shown.size());
+  for (const views::View* view : shown) {
+    atlas::sidebar::SectionRow row;
+    row.kind = atlas::sidebar::RowKind::kOther;
+    if (const auto* tab_view = views::AsViewClass<TabView>(view)) {
+      row.kind = atlas::sidebar::RowKind::kTab;
+      row.active = tab_view->IsActive();
+      if (const tabs::TabInterface* tab = tab_view->GetTabInterface()) {
+        row.last_active = tab->GetLastActiveTime();
+      }
+    } else if (views::IsViewClass<TabGroupView>(view)) {
+      row.kind = atlas::sidebar::RowKind::kGroup;
+    }
+    rows.push_back(row);
+  }
+  return atlas::sidebar::SectionHeaders(rows, base::Time::Now());
+}
+
+void UnpinnedTabContainerView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  if (!ShowsAtlasSectionHeaders()) {
+    return;
+  }
+  std::vector<const views::View*> shown;
+  for (const views::View* child : collection_node_->GetDirectChildren()) {
+    if (child->GetVisible()) {
+      shown.push_back(child);
+    }
+  }
+  const std::vector<std::optional<atlas::sidebar::Section>> headers =
+      GetAtlasSectionHeaders(shown);
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const int row_left =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  for (size_t i = 0; i < shown.size(); ++i) {
+    // The row being dragged keeps its band but leaves its label behind.
+    if (!headers[i] || IsViewDragging(*shown[i])) {
+      continue;
+    }
+    const int band_height = atlas::sidebar::HeaderBandHeight(true, true);
+    atlas::sidebar::PaintSectionHeader(
+        canvas, gfx::Rect(0, shown[i]->y() - band_height, width(), band_height),
+        row_left, *headers[i], *color_provider);
+  }
+}
+
 
