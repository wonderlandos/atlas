+void VerticalNewTabButton::PaintButtonContents(gfx::Canvas* canvas) {
+  shared::NewTabButton::PaintButtonContents(canvas);
+  // Atlas: the rule above the footer row and the shortcut at its right.
+  if (const ui::ColorProvider* color_provider = GetColorProvider()) {
+    atlas::sidebar::PaintFooterDecorations(canvas, GetLocalBounds(),
+                                           /*row_inset=*/0, base::i18n::IsRTL(),
+                                           *color_provider);
+  }
+}
