+// Switching the tracker blocker off unloads the built-in component now; the preference keeps
+// it off at every start (component_loader.cc).
+void UnloadTrackerBlocker(content::BrowserContext* context, bool on) {
+  if (!on) {
+    extensions::ComponentLoader::Get(context)->Remove(
+        helium::kUBlockOriginComponentId);
+  }
+}
