   if (!canonicalized_url->is_valid())
     return metrics::OmniboxInputType::QUERY;
 
+  // Atlas (ADR 0052): a Federate name is exclusively fed://. A bare name
+  // (home.fed, lobo.pagina/x) or an http(s) spelling of it is an address whose
+  // host has a known Federate TLD, so it is a URL (fixed up to fed://), never
+  // the "unknown TLD" guess that sends it to the search provider.
+  // (SegmentURL() reports "http" for an input typed without a scheme.)
+  if (base::EqualsCaseInsensitiveASCII(parsed_scheme_utf8, url::kHttpScheme) ||
+      base::EqualsCaseInsensitiveASCII(parsed_scheme_utf8, url::kHttpsScheme)) {
+    if (std::optional<GURL> fed = atlas_fed::MapHttpToFed(*canonicalized_url)) {
+      *canonicalized_url = *fed;
+      return metrics::OmniboxInputType::URL;
+    }
+  }
