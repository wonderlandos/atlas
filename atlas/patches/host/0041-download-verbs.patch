+ui::SimpleMenuModel* DownloadUiContextMenu::GetAtlasFinishedMenuModel() {
+  if (atlas_finished_download_menu_model_) {
+    return atlas_finished_download_menu_model_.get();
+  }
+
+  auto model = std::make_unique<ui::SimpleMenuModel>(this);
+  const std::u16string name =
+      download_ ? download_->GetFileNameToReportUser().LossyDisplayName()
+                : std::u16string();
+  auto add = [&](int command_id, int accessible_name_id) {
+    model->AddItem(command_id, GetLabelForCommandId(command_id));
+    if (accessible_name_id) {
+      model->SetAccessibleNameAt(
+          model->GetItemCount() - 1,
+          l10n_util::GetStringFUTF16(accessible_name_id, name));
+    }
+  };
+  add(DownloadCommands::OPEN_WHEN_COMPLETE, 0);
+  add(atlas_host::kCommandOpenWith,
+      IDS_ATLAS_DOWNLOAD_MENU_OPEN_WITH_ACCESSIBLE_NAME);
+  add(atlas_host::kCommandShare, IDS_ATLAS_DOWNLOAD_MENU_SHARE_ACCESSIBLE_NAME);
+  add(DownloadCommands::SHOW_IN_FOLDER,
+      IDS_ATLAS_DOWNLOAD_MENU_SHOW_IN_FILES_ACCESSIBLE_NAME);
+  model->AddSeparator(ui::NORMAL_SEPARATOR);
+  add(atlas_host::kCommandMoveToTrash,
+      IDS_ATLAS_DOWNLOAD_MENU_MOVE_TO_TRASH_ACCESSIBLE_NAME);
+
+  atlas_finished_download_menu_model_ = std::move(model);
+  return atlas_finished_download_menu_model_.get();
+}
+
+void DownloadUiContextMenu::RunAtlasVerb(int command_id) {
+  if (!download_) {
+    return;
+  }
+  atlas_host::RunDownloadVerb(
+      command_id, download_->GetFullPath(),
+      base::BindOnce(&DownloadUiContextMenu::OnAtlasVerbDone,
+                     weak_factory_.GetWeakPtr(), command_id));
+}
+
+void DownloadUiContextMenu::OnAtlasVerbDone(int command_id,
+                                            atlas_host::Result result) {
+  if (!result.ok) {
+    // A cancelled sheet is not an error and says nothing; a failure says what
+    // the desktop said, as it is.
+    // As a sheet of the window that holds the downloads list, if it is there.
+    BrowserWindowInterface* browser =
+        download_commands_ ? download_commands_->GetBrowser() : nullptr;
+    chrome::ShowWarningMessageBoxAsync(
+        browser ? browser->GetWindow()->GetNativeWindow()
+                : gfx::NativeWindow(),
+        l10n_util::GetStringUTF16(IDS_ATLAS_DOWNLOAD_VERB_FAILED_TITLE),
+        base::UTF8ToUTF16(result.text));
+    return;
+  }
+  if (command_id == atlas_host::kCommandMoveToTrash && download_ &&
+      download_->profile()) {
+    // The file is gone from the folder: let the downloads list find out now
+    // and show the row as removed.
+    download_->profile()->GetDownloadManager()->CheckForHistoryFilesRemoval();
+  }
+}
