assert(!is_android)

# Atlas toolbar (owner: ATLAS-TOOLBAR). Linked into //chrome/browser/ui, which allows this target to include
# its headers (anchor patch 0010). Engine files reach it through three hooks (patch 0030).
source_set("toolbar") {
  sources = [
    "bookmark_button.cc",
    "bookmark_button.h",
    "privacy_bubble.cc",
    "privacy_bubble.h",
    "privacy_button.cc",
    "privacy_button.h",
    "privacy_state.cc",
    "privacy_state.h",
    "toolbar_buttons.cc",
    "toolbar_buttons.h",
    "toolbar_glyphs.cc",
    "toolbar_glyphs.h",
    "toolbar_ids.cc",
    "toolbar_ids.h",
    "toolbar_prefs.cc",
    "toolbar_prefs.h",
  ]
  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/ui/atlas/toolbar/vector_icons",
    "//chrome/browser/ui/bookmarks",
    "//chrome/browser/ui/views/toolbar:toolbar_button",
  ]
  deps = [
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/toolbar",
    "//chrome/browser/ui/views:layout_provider",
    "//components/omnibox/browser:vector_icons",
    "//components/pref_registry",
    "//components/prefs",
    "//components/strings",
    "//components/vector_icons",
    "//ui/base",
    "//ui/color",
    "//ui/views",
  ]
}

# Unit tests of this area (testonly); //chrome/browser/ui/atlas:unit_tests collects them.
source_set("unit_tests") {
  testonly = true
  sources = [
    "privacy_bubble_unittest.cc",
    "privacy_button_unittest.cc",
    "privacy_state_unittest.cc",
    "toolbar_buttons_unittest.cc",
    "toolbar_prefs_unittest.cc",
  ]
  deps = [
    ":toolbar",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//components/pref_registry",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//ui/views:test_support",
  ]
}
