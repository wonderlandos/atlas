// The Federate mark in the location bar, in place of the padlock: the eight-spoke asterisk of the
// network's logo (sites/federate-network/logo.svg of the Federate repository, MIT) redrawn as a
// WolOS symbolic glyph, 16 px grid, 1.5 px round stroke; it follows the theme's icon colour.

CANVAS_DIMENSIONS, 16,
STROKE, 1.5f,
MOVE_TO, 8, 2,
LINE_TO, 8, 14,
MOVE_TO, 2, 8,
LINE_TO, 14, 8,
MOVE_TO, 3.757f, 3.757f,
LINE_TO, 12.243f, 12.243f,
MOVE_TO, 3.757f, 12.243f,
LINE_TO, 12.243f, 3.757f
