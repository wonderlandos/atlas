  <message name="IDS_ATLAS_VAULT_APP_MENU_PASSWORDS" desc="Item in the app menu that opens the saved passwords page.">
    Passwords
  </message>
  <message name="IDS_ATLAS_VAULT_SETTINGS_PASSWORDS" desc="Entry in the settings menu that opens the saved passwords page in a new tab.">
    Passwords
  </message>
</grit-part>
